e":"Compendium.pf2e-animal-companions.AC-Features.Item.v5dfcKYsaD0EvvtH","duplicateSource":null,"exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"folder":null,"sort":10700000,"_id":"rZ6xd6OkT6VpA8rS","ownership":{"default":0}},{"name":"Demonic Strikes","type":"feat","img":"systems/pf2e/icons/spells/all-is-one-one-is-all.webp","effects":[],"flags":{"core":{},"pf2e":{"grantedBy":{"id":"2lx8nIdC5pKZefMj","onDelete":"cascade"}}},"system":{"description":{"gm":"","value":"<p>Your eidolon's attacks are corrupted by the Abyss and imbued with pure evil and shifting chaos. Your eidolon's unarmed Strikes gain the unholy trait and deal 1 extra spirit damage to holy creatures and creatures with weakness to unholy. Additionally, choose one of your eidolon's unarmed attacks that deals physical damage; it gains the versatile trait for a different type of physical damage you choose.</p>"},"rules":[{"key":"FlatModifier","selector":"strike-damage","value":1,"damageType":"spirit","predicate":["target:trait:holy"]},{"key":"AdjustStrike","mode":"add","property":"traits","value":"unholy"}],"slug":"demonic-strikes","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"traits":{"otherTags":[],"value":[],"rarity":"common"},"publication":{"title":"Pathfinder Secrets of Magic","authors":"","license":"OGL","remaster":false},"level":{"value":1},"category":"classfeature","onlyLevel1":false,"maxTakable":1,"actionType":{"value":"passive"},"actions":{"value":null},"prerequisites":{"value":[]},"location":null,"subfeatures":{"proficiencies":{},"senses":{},"suppressedFeatures":[]}},"_stats":{"compendiumSource":"Compendium.pf2e-animal-companions.AC-Features.Item.o3P8heIfNr1z53Ay","duplicateSource":null,"exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"folder":"4oaqgJDRdOmg12Mo","sort":200000,"_id":"jIrPGS6yf30GxqRg","ownership":{"default":0}},{"type":"lore","name":"Cult","effects":[],"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.959,"lastMigration":null,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"traits":{"otherTags":[]},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"mod":{"value":0},"proficient":{"value":1}},"_id":"irtliJLYvTMtj9Rk","img":"systems/pf2e/icons/default-icons/lore.svg","folder":null,"sort":0,"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"ownership":{"default":0}},{"name":"Icicle Spear","type":"weapon","effects":[],"system":{"description":{"gm":"","value":""},"rules":[],"slug":null,"_migration":{"version":0.959,"lastMigration":null,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"traits":{"otherTags":[],"value":["propulsive"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":0},"quantity":1,"baseItem":null,"bulk":{"value":0},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{}},"equipped":{"carryType":"held","invested":null,"handsHeld":0,"inSlot":false},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"","img":"","data":{"description":{"value":""}}}},"usage":{"value":"worngloves"},"category":"unarmed","group":null,"bonus":{"value":0},"damage":{"dice":1,"die":"d4","damageType":"cold","persistent":null},"splashDamage":{"value":0},"range":30,"expend":null,"ammo":null,"reload":{"value":null},"grade":null,"runes":{"potency":1,"striking":1,"property":[]},"specific":null,"subitems":[]},"_id":"8uULOQWtg2de69pr","img":"systems/pf2e/icons/default-icons/weapon.svg","folder":null,"sort":10800000,"flags":{},"_stats":{"compendiumSource":"Actor.7CzSN7bnCRQGa7yG.Item.8uULOQWtg2de69pr","duplicateSource":"Actor.7CzSN7bnCRQGa7yG.Item.8uULOQWtg2de69pr","exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"ownership":{"default":0}},{"_id":"LlY50sp149CzS7uB","img":"icons/creatures/eyes/lizard-single-slit-pink.webp","name":"Shared Vigilance","system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"classfeature","description":{"value":"<p>You and your eidolon work together to remain alert to threats around you, allowing you to perceive far more together than you could individually. Your proficiency rank in Perception and your eidolon's proficiency rank in Perception increase to expert.</p>","gm":""},"level":{"value":3,"taken":4},"prerequisites":{"value":[]},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Secrets of Magic","authors":""},"rules":[],"subfeatures":{"proficiencies":{"perception":{"rank":2,"attribute":null}},"senses":{},"suppressedFeatures":[]},"traits":{"rarity":"common","value":["summoner"],"otherTags":[]},"slug":"shared-vigilance","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"onlyLevel1":false,"maxTakable":1,"location":"classfeature"},"type":"feat","_stats":{"compendiumSource":"Compendium.pf2e.classfeatures.Item.QiMlJ33kNEoyh1M0","duplicateSource":null,"exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"effects":[],"folder":null,"sort":0,"flags":{},"ownership":{"default":0}},{"_id":"PORV9iXPPbOQ9j0V","img":"systems/pf2e/icons/features/classes/link-spells.webp","name":"Link Spells","system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"classfeature","description":{"value":"<p>Your connection to your eidolon allows you to cast link spells, special spells that have been forged through your shared connection with your eidolon. Link spells are a type of focus spell. It costs 1 Focus Point to cast a focus spell, and you start with a focus pool of 1 Focus Point. You refill your focus pool during your daily preparations, and you can regain 1 Focus Point by spending 10 minutes using the Refocus activity to specifically connect with your eidolon, such as by having a heart-to-heart conversation, playing together, or meditating in unison on the nature of your bond.</p>\n<p>Focus spells are automatically heightened to half your level rounded up, much like cantrips. Focus spells don't require spell slots, and you can't cast them using spell slots. Taking feats can give you more focus spells and increase the size of your focus pool, though your focus pool can never hold more than 3 Focus Points. The full rules for focus spells appear on page 300 of the Core Rulebook.</p>\n<p>You learn the @UUID[Compendium.pf2e.spells-srd.Item.lV8FkHZtzZu7Cy6j]{Evolution Surge} link spell, which allows you to grant your eidolon one of several useful benefits.</p>\n<h3>Link Cantrips</h3>\n<p>Link cantrips are special link spells that don't cost Focus Points, so you can cast them as often as you like. Link cantrips are in addition to the cantrips you choose from your tradition's spell list. Generally, only feats can give you more link cantrips. Unlike other cantrips, you can't swap out link cantrips gained from summoner feats at a later level, unless you swap out the specific feat via retraining.</p>\n<p>You learn the @UUID[Compendium.pf2e.spells-srd.Item.HStu2Yhw3iQER9tY]{Boost Eidolon} link cantrip, which briefly improves your eidolon's capabilities, allowing it to attack with greater power.</p>","gm":""},"level":{"value":1,"taken":4},"prerequisites":{"value":[]},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Secrets of Magic","authors":""},"rules":[],"traits":{"rarity":"common","value":["summoner"],"otherTags":[]},"slug":"link-spells","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"onlyLevel1":false,"maxTakable":1,"subfeatures":{"proficiencies":{},"senses":{},"suppressedFeatures":[]},"location":"classfeature"},"type":"feat","_stats":{"compendiumSource":"Compendium.pf2e.classfeatures.Item.wguqw300DB5XdD8W","duplicateSource":null,"exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"effects":[],"folder":null,"sort":0,"flags":{},"ownership":{"default":0}},{"_id":"Z55ILJBl2S6m6Z2s","folder":"r6eVJohxZLs8MvnZ","img":"icons/sundries/books/book-red-exclamation.webp","name":"Tandem Movement","system":{"actionType":{"value":"action"},"actions":{"value":1},"category":"class","description":{"value":"<p>You and your eidolon move together. You each use a single action to Stride. Either of you that has the corresponding movement type can Burrow, Climb, Fly, or Swim instead.</p>","gm":""},"level":{"value":4,"taken":4},"prerequisites":{"value":[]},"publication":{"license":"OGL","remaster":false,"title":"Pathfinder Secrets of Magic","authors":""},"rules":[],"traits":{"rarity":"common","value":["summoner","tandem"],"otherTags":[]},"slug":"tandem-movement","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"onlyLevel1":false,"maxTakable":1,"subfeatures":{"proficiencies":{},"senses":{},"suppressedFeatures":[]},"location":"class-4"},"type":"feat","_stats":{"compendiumSource":"Compendium.pf2e.feats-srd.Item.qmx8QwVepqI9FqiD","duplicateSource":null,"exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"effects":[],"sort":0,"flags":{},"ownership":{"default":0}},{"folder":"NnWkuvbKXtwc0nEt","img":"systems/pf2e/icons/actions/Passive.webp","name":"Avoid Notice","system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"defensive","description":{"value":"<p>You attempt a [[/act avoid-notice]]{Stealth} check to avoid notice while traveling at half speed. If you're Avoiding Notice at the start of an encounter, you usually roll a Stealth check instead of a Perception check both to determine your initiative and to see if the enemies notice you (based on their Perception DCs, as normal for @UUID[Compendium.pf2e.actionspf2e.Item.VMozDqMMuK5kpoX4]{Sneak}, regardless of their initiative check results).</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Player Core","authors":""},"rules":[],"traits":{"value":["exploration"],"otherTags":[]},"slug":"avoid-notice","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}}},"type":"action","_stats":{"compendiumSource":"Compendium.pf2e.actionspf2e.Item.IE2nThCmoyhQA0Jn","duplicateSource":null,"exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"effects":[],"sort":0,"flags":{},"_id":"86DWdGRh2qdbGwUq","ownership":{"default":0}},{"folder":"NnWkuvbKXtwc0nEt","img":"systems/pf2e/icons/actions/Passive.webp","name":"Scout","system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"interaction","description":{"value":"<p>You scout ahead and behind the group to watch danger, moving at half speed. At the start of the next encounter, every creature in your party gains a +1 circumstance bonus to their initiative rolls.</p>\n<p>@UUID[Compendium.pf2e.other-effects.Item.EMqGwUi3VMhCjTlF]{Effect: Scout}</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Player Core","authors":""},"rules":[],"traits":{"value":["concentrate","exploration"],"otherTags":[]},"slug":"scout","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}}},"type":"action","_stats":{"compendiumSource":"Compendium.pf2e.actionspf2e.Item.kV3XM0YJeS2KCSOb","duplicateSource":null,"exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"effects":[],"sort":0,"flags":{},"_id":"Y8mLjhPZHtaXR66p","ownership":{"default":0}},{"folder":"NnWkuvbKXtwc0nEt","img":"systems/pf2e/icons/actions/Passive.webp","name":"Search","system":{"actionType":{"value":"passive"},"actions":{"value":null},"category":"interaction","description":{"value":"<p>You @UUID[Compendium.pf2e.actionspf2e.Item.BlAOM2X92SI6HMtJ]{Seek} meticulously for hidden doors, concealed hazards, and so on. You can usually make an educated guess as to which locations are best to check and move at half speed, but if you want to be thorough and guarantee you checked everything, you need to travel at a Speed of no more than 300 feet per minute, or 150 feet per minute to ensure you check everything before you walk into it. You can always move more slowly while Searching to cover the area more thoroughly, and the @UUID[Compendium.pf2e.feats-srd.Item.GdZLxDtFXaQI3Fop]{Expeditious Search} feat increases these maximum Speeds. If you come across a secret door, item, or hazard while Searching, the GM will attempt a free secret check to Seek to see if you notice the hidden object or hazard. In locations with many objects to search, you have to stop and spend significantly longer to search thoroughly.</p>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Player Core","authors":""},"rules":[],"traits":{"value":["concentrate","exploration"],"otherTags":[]},"slug":"search","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}}},"type":"action","_stats":{"compendiumSource":"Compendium.pf2e.actionspf2e.Item.TiNDYUGlMmxzxBYU","duplicateSource":null,"exportSource":null,"coreVersion":"14.363","systemId":"pf2e","systemVersion":"8.2.0","lastModifiedBy":"Om2THqk3vEFcx1CE","createdTime":1780493337481,"modifiedTime":1780493337481},"effects":[],"sort":0,"flags":{},"_id":"TdpfpMXJcnNnwKUh","ownership":{"default":0}},{"_id":"EppGKHC5P2qqtdBB","name":"Energy Heart (CC)","type":"feat","img":"systems/pf2e/icons/features/feats/feats.webp","effects":[],"folder":null,"sort":0,"flags":{"core":{}},"system":{"description":{"gm":"","value":"<p>Your eidolon's heart beats with energy.</p>\n<p>Choose an energy damage type other than force. One of its unarmed attacks changes its damage type to the chosen type, and it gains resistance to that type equal to half your level (minimum 1).</p>"},"rules":[{"adjustName":false,"choices":[{"label":"PF2E.TraitAcid","value":"acid"},{"label":"PF2E.TraitCold","value":"cold"},{"label":"PF2E.TraitFire","value":"fire"},{"label":"PF2E.TraitElectricity","value":"electricity"},{"label":"PF2E.TraitVitality","value":"vitality"},{"label":"PF2E.TraitVoid","value":"void"},{"label":"PF2E.TraitSonic","value":"sonic"}],"flag":"damageChoice","prompt":"PF2E.UI.RuleElements.ChoiceSet.Prompt","key":"ChoiceSet","selection":"electricity"},{"key":"ActiveEffectLike","mode":"override","path":"flags.pf2e.evolutionFeats.energyHeartChoice","value":"{item|flags.pf2e.rulesSelections.damageChoice}"},{"key":"Resistance","type":"{actor|flags.pf2e.evolutionFeats.energyHeartChoice}","value":"max(1,floor(@actor.level/2))"}],"slug":"energy-heart-cc","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"traits":{"otherTags":[],"value":["evolution","summoner"],"rarity":"common"},"publication":{"title":"","authors":"","license":"OGL","remaster":false},"level":{"value":1,"taken":1},"category":"class","onlyLevel1":false,"maxTakable":1,"actionType":{"value":"passive"},"actions":{"value":null},"prerequisi