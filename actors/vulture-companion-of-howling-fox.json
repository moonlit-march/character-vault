"pfs":{"playerNumber":null,"characterNumber":null,"levelBump":false,"currentFaction":"EA","school":null,"reputation":{"EA":null,"GA":null,"HH":null,"VS":null,"RO":null,"VW":null}},"exploration":[]},"img":"https://assets.forge-vtt.com/645db2a976d10d3e3cde16b0/modules/the-moonlit-march-module/ART/PLAYER%20CHARACTERS/FULL%20ART/FA_VULTURE_HOWLING-FOX_SQUIDBUFFET.webp","items":[{"name":"Hyena","type":"ancestry","img":"https://assets.forge-vtt.com/bazaar/systems/pf2e/assets/icons/default-icons/ancestry.svg","effects":[],"folder":"Rn81F1uZdgYGoXoS","sort":4400000,"flags":{"core":{},"pf2e":{"itemGrants":{"animalCompanion":{"id":"kvI0h8QJZPvXIaxL","onDelete":"detach"},"hyenaSupportBenefit":{"id":"V7BdSKNeXDYZiwet","onDelete":"detach"}}}},"system":{"description":{"gm":"","value":"<p>Your companion is a hyena</p><p><strong>Size</strong> Small</p><p><strong>Melee</strong> <span class=\"pf2-icon\">1</span> jaws (finesse), <strong>Damage</strong> 1d8 piercing</p><p><strong>Str</strong> +2, <strong>Dex</strong> +3, <strong>Con</strong> +2, <strong>Int</strong> –4, <strong>Wis</strong> +1, <strong>Cha</strong> +0</p><p><strong>Hit Points</strong> 6</p><p><strong>Skill</strong> Intimidation</p><p><strong>Senses</strong> low-light vision, scent (imprecise, 30 feet)</p><p><strong>Speed</strong> 40 feet</p><p><strong>Support Benefit</strong> The hyena mockingly yowls at your enemies and bites at them when you create an opening. Until the start of your next turn, each time you hit a creature in the hyena's reach with a Strike, the creature becomes @UUID[Compendium.pf2e.conditionitems.Item.TBSHQspnbcqxsmjL]{Frightened 1}.</p><p><strong>Advanced Maneuver</strong> @UUID[Compendium.pf2e-animal-companions.AC-Advanced-Maneuvers.Item.oisXYTTYE0TABboA]{Gnaw}</p>"},"rules":[{"key":"GrantItem","uuid":"Compendium.pf2e-animal-companions.AC-Features.Item.KKOgokqHa7RjVDN6","flag":"animalCompanion"},{"key":"ActiveEffectLike","value":2,"mode":"add","path":"system.abilities.str.mod"},{"key":"ActiveEffe