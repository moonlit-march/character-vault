@item.flags.system.rulesSelections.degreeOfSuccess"},{"key":"RollOption","label":"PF2E.SpecificRule.Harrowing.RerollLabel","option":"harrowing-reroll","toggleable":true,"value":false}],"start":{"value":-15323,"initiative":null},"tokenIcon":{"show":true},"traits":{"value":[],"otherTags":[]},"slug":"spell-effect-harrowing","_migration":{"version":0.959,"previous":null},"unidentified":false,"badge":null,"fromSpell":false,"context":null},"type":"effect","_stats":{"coreVersion":"14.365","systemId":"pf2e","systemVersion":"8.4.0","compendiumSource":"Compendium.pf2e.spell-effects.Item.LfxwvZRwtrh8mQN0","createdTime":1786130422543,"modifiedTime":1786130422543,"lastModifiedBy":"nUdv3WqjIHS56lks","duplicateSource":null,"exportSource":null},"effects":[],"folder":null,"sort":0,"flags":{},"_id":"dy9tyVGaJSijIDRe","ownership":{"default":0}},{"folder":"0Z6sKp3ActW2pM2e","img":"https://assets.forge-vtt.com/bazaar/systems/pf2e/assets/icons/actions/OneAction.webp","name":"Balance","system":{"actionType":{"value":"action"},"actions":{"value":1},"category":null,"description":{"value":"<p><strong>Requirements</strong> You are in a square that contains a narrow surface, uneven ground, or another similar feature.</p><hr><p>You move across a narrow surface or uneven ground, attempting an [[/act balance]]{Acrobatics} check against its Balance DC. You are @UUID[Compendium.pf2e.conditionitems.Item.AJh5ex99aV6VTggg]{Off-Guard} while on a narrow surface or uneven ground.</p><hr><p><strong>Critical Success</strong> You move up to your Speed.</p>\n<p><strong>Success</strong> You move up to your Speed, treating it as difficult terrain (every 5 feet costs 10 feet of movement).</p>\n<p><strong>Failure</strong> You must remain stationary to keep your balance (wasting the action) or you fall. If you fall, your turn ends.</p>\n<p><strong>Critical Failure</strong> You fall and your turn ends.</p><h2 class=\"title\">Sample Balance Tasks</h2><ul><li><strong>Untrained</strong> tangled roots, uneven cobblestones</li><li><strong>Trained</strong> wooden beam</li><li><strong>Expert</strong> deep, loose gravel</li><li><strong>Master</strong> tightrope, smooth sheet of ice</li><li><strong>Legendary</strong> razor's edge, chunks of floor falling in midair</li></ul>","gm":""},"publication":{"license":"ORC","remaster":true,"title":"Pathfinder Player Core","authors":""},"rules":[],"traits":{"value":["move"],"otherTags":[]},"slug":"balance","_migration":{"version":0.959,"previous":null}},"type":"action","_stats":{"coreVersion":"14.365","systemId":"pf2e","systemVersion":"8.4.0","compendiumSource":"Compendium.pf2e.actionspf2e.Item.M76ycLAqHoAgbcej","createdTime":1786130422543,"modifiedTime":1786130422543,"lastModifiedBy":"nUdv3WqjIHS56lks","duplicateSource":null,"exportSource":null},"effects":[],"sort":0,"flags":{},"_id":"7jYaTkYRi7YCn07i","ownership":{"default":0}}],"folder":"EnK5NbyC1Pfw0h4S","flags":{"pf2e":{"sheetTabs":{"pfs":false},"showBasicUnarmed":true,"dailyCraftingComplete":false},"scene-packer":{"sourceId":"Actor.qSTTZL7gopHyPeyl","defaultPermission":1},"pf2e-dailies":{"rested":true}},"_stats":{"coreVersion":"14.365","systemId":"pf2e","systemVersion":"8.4.0","createdTime":1786130422539,"modifiedTime":1786151159621,"lastModifiedBy":"tOyMFlNcbpj5s6pz","compendiumSource":"Compendium.the-moonlit-march-module.actors.Actor.nxq1GxCcBjkNsXKG","duplicateSource":null,"exportSource":{"worldId":"the-moonlit-march","uuid":"Actor.poiq7kjrslyVVwoR","coreVersion":"14.365","systemId":"pf2e","systemVersion":"8.3.0"}},"ownership":{"default":1,"tOyMFlNcbpj5s6pz":3,"nUdv3WqjIHS56lks":3},"_id":"TVA1XgUceeGweB9I","sort":1000000}