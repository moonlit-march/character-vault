":"str"},"xp":{"value":0,"min":0,"max":1000},"age":{"value":""},"height":{"value":""},"weight":{"value":""},"gender":{"value":""},"ethnicity":{"value":""},"nationality":{"value":""},"alliance":"party"},"resources":{"heroPoints":{"value":0,"max":3}},"_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"abilities":null,"skills":{},"pfs":{"playerNumber":null,"characterNumber":null,"levelBump":false,"currentFaction":"EA","school":null,"reputation":{"EA":null,"GA":null,"HH":null,"VS":null,"RO":null,"VW":null}},"exploration":[]},"img":"https://assets.forge-vtt.com/645db2a976d10d3e3cde16b0/modules/the-moonlit-march-module/ART/PLAYER%20CHARACTERS/FULL%20ART/FA_EAT-THE-ROCKS_WENDIBLOOM_MYNAMEISJAMES.webp","items":[{"name":"Mole","type":"ancestry","effects":[],"system":{"description":{"gm":"","value":"<p>Your companion is a giant mole, gopher, or prairie dog.</p>\n<p><strong>Size </strong>Small</p>\n<p><strong>Melee </strong><span class=\"pf2-icon\">1</span> jaws, Damage 1d8 piercing</p>\n<p><strong>Melee </strong><span class=\"pf2-icon\">1</span> claw (agile), Damage 1d6 slashing</p>\n<p><strong>Str </strong>+3, <strong>Dex </strong>+2, <strong>Con </strong>+2, <strong>Int </strong>–4, <strong>Wis </strong>+1, <strong>Cha </strong>+0</p>\n<p><strong>Hit Points</strong> 8</p>\n<p><strong>Skill </strong>Stealth</p>\n<p><strong>Senses</strong> low-light vision, scent (imprecise, 30 feet)</p>\n<p><strong>Speed </strong>25 feet, burrow 20 feet</p>\n<p><strong>Support Benefit </strong>Your mole leaps into the ground and burrows beneath your foes, disturbing their footing. Until the end of your next turn, if you hit and damage a creature adjacent to your mole, that creature is @UUID[Compendium.pf2e.conditionitems.Item.i3OJZU2nk64Df3xm]{Clumsy 1} until it moves from its current position.</p>\n<p><strong>Advanced Maneuver</strong> @UUID[Compendium.pf2e-animal-companions.AC-Advanced-Maneuvers.Item.PZAHlaN4aG6NkSjj]{Burrowing Ambush}</p>"},"rul