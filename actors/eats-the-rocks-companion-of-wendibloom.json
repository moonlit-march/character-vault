lue":[]}},"flaws":{"0":{"value":[]}},"languages":{"value":["common"],"custom":""},"additionalLanguages":{"count":0,"value":[],"custom":""},"items":{},"vision":"low-light-vision"},"img":"https://assets.forge-vtt.com/bazaar/systems/pf2e/assets/icons/default-icons/ancestry.svg","folder":"Rn81F1uZdgYGoXoS","sort":4900000,"flags":{"scene-packer":{"hash":"43b16e36e682a18d0fd1132569a543c9b7ec1329"},"pf2e":{"itemGrants":{"animalCompanion":{"id":"JbfshlK9Jnw8H0g0","onDelete":"detach"},"moleSupportBenefit":{"id":"V80HGS1mKLsJzAp3","onDelete":"detach"}}}},"_stats":{"compendiumSource":"Compendium.pf2e-animal-companions.AC-Ancestries-and-Class.Item.qbnExhXh5IqzWQmy","duplicateSource":null,"exportSource":null,"coreVersion":"14.365","systemId":"pf2e","systemVersion":"8.4.0","lastModifiedBy":"53O0mh8zBT7Xr905","createdTime":1785703298831,"modifiedTime":1786034952284},"_id":"Ru8fbZ2hJSSm3kXy","ownership":{"default":0}},{"name":"Animal Companion","type":"class","img":"https://assets.forge-vtt.com/bazaar/systems/pf2e/assets/icons/default-icons/class.svg","effects":[],"flags":{"core":{},"pf2e":{"grantedBy":{"id":"Ru8fbZ2hJSSm3kXy","onDelete":"cascade"}}},"system":{"description":{"gm":"","value":"<p>The following are the base statistics for a young animal companion, the first animal companion most characters get. You adjust these statistics depending on the type of animal you choose. Animal companions calculate their modifiers and DCs just as you do with one difference: the only item bonuses they can benefit from are to Speed and AC (their maximum item bonus to AC is +3). As you gain levels, you might be able to make your companion stronger by advancing it.</p><p>An animal companion's starting statistics are as follows.</p><ul><li><strong>Level:</strong> Your animal companion's level is equal to yours.</li><li><strong>Proficiencies:</strong> Your animal companion is trained in its unarmed attacks, unarmored defense, barding (a type of armor for animals), all saving throws, Perception, Acrobatics, and Athletics. Animal companions can't use abilities that require greater Intelligence, such as @UUID[Compendium.pf2e.actionspf2e.Item.tHCqgwjtQtzNqVvd]{Coerce} or Decipher Writing, even if trained in the appropriate skill, unless they have a specialization that allows it.</li><li><strong>Attribute Modifiers:</strong> An animal companion begins with base attribute modifiers listed in its stat block.</li><li><strong>Hit Points:</strong> Your animal companion has ancestry Hit Points from its type, plus a number of Hit Points equal to 6 plus its Constitution modifier for each level you have.</li></ul>"},"rules":[{"key":"ActiveEffectLike","mode":"override","path":"flags.pf2e.disableABP","value":true,"priority":10},{"key":"ActorTraits","add":["minion"]},{"key":"ActiveEffectLike","mode":"upgrade","path":"system.proficiencies.defenses.light-barding.rank","priority":41,"value":1},{"key":"ActiveEffectLike","mode":"upgrade","path":"system.proficiencies.defenses.heavy-barding.rank","priority":41,"value":1},{"key":"AdjustModifier","predicate":["bonus:type:item"],"selectors":["attack","damage","skill-check","saving-throw"],"suppress":true},{"key":"AdjustModifier","predicate":["bonus:type:item"],"selectors":["ac"],"mode":"downgrade","value":3}],"slug":"animal-companion","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"traits":{"otherTags":[],"rarity":"common"},"publication":{"title":"Pathfinder Player Core","authors":"","license":"ORC","remaster":true},"keyAbility":{"value":[],"selected":null},"items":{},"hp":6,"trainedSkills":{"value":["acrobatics","athletics"],"additional":0},"perception":1,"savingThrows":{"fortitude":1,"reflex":1,"will":1},"attacks":{"simple":0,"martial":0,"advanced":0,"unarmed":1,"other":{"name":"","rank":0}},"defenses":{"unarmored":1,"light":0,"medium":0,"heavy":0},"spellcasting":0,"ancestryFeatLevels":{"value":[]},"classFeatLevels":{"value":[]},"generalFeatLevels":{"value":[]},"skillFeatLevels":{"value":[]},"skillIncreaseLevels":{"value":[]}},"_stats":{"compendiumSource":"Compendium.pf2e-animal-companions.AC-Features.Item.KKOgokqHa7RjVDN6","duplicateSource":null,"exportSource":{"worldId":"ac","uuid":null,"coreVersion":"0.8.8","systemId":"pf2e","systemVersion":"2.6.0.6437"},"coreVersion":"14.365","systemId":"pf2e","systemVersion":"8.4.0","lastModifiedBy":"53O0mh8zBT7Xr905","createdTime":1785703298831,"modifiedTime":1785703298831},"folder":null,"sort":3600000,"_id":"JbfshlK9Jnw8H0g0","ownership":{"default":0}},{"name":"Mole Support Benefit","type":"action","effects":[],"system":{"description":{"gm":"","value":"<p>Your mole leaps into the ground and burrows beneath your foes, disturbing their footing. Until the end of your next turn, if you hit and damage a creature adjacent to your mole, that creature is @UUID[Compendium.pf2e.conditionitems.Item.i3OJZU2nk64Df3xm]{Clumsy 1} until it moves from its current position.</p><p>@UUID[Compendium.pf2e-animal-companions.AC-effects.Item.6X2STQsZYQ4pY6BA]{Effect: Mole Support Benefit}</p>"},"rules":[],"slug":"mole-support-benefit","_migration":{"version":0.959,"previous":{"schema":0.955,"foundry":"14.361","system":"8.1.2"}},"traits":{"otherTags":[],"value":[]},"publication":{"title":"Pathfinder: Howl of the Wild","authors":"","license":"ORC","remaster":true},"actionType":{"value":"action"},"category":"offensive","actions":{"value":1},"deathNote":false},"img":"https://assets.forge-vtt.com/bazaar/systems/pf2e/assets/icons/actions/OneAction.webp","folder":null,"sort":4200000,"flags":{"scene-packer":{"hash":"19d0a192df965aa9ad6bd505b88b847e46957ba6"},"pf2e":{"grantedBy":{"id":"Ru8fbZ2hJSSm3kXy","onDelete":"cascade"}}},"_stats":{"compendiumSource":"Compendium.pf2e-animal-companions.AC-Support.Item.vvuB2kEzRYSs4IpH","duplicateSource":null,"exportSource":null,"coreVersion":"14.365","systemId":"pf2e","systemVersion":"8.4.0","lastModifiedBy":"53O0mh8zBT7Xr905","createdTime":1785703298831,"modifiedTime":1785703298831},"_id":"V80HGS1mKL