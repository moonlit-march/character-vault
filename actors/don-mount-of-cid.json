S/FULL%20ART/FA_DON_CID-GARCIA_LADEN.webp","items":[{"name":"Horse","type":"ancestry","img":"systems/pf2e/icons/default-icons/ancestry.svg","effects":[],"folder":"Rn81F1uZdgYGoXoS","sort":4300000,"flags":{"core":{},"pf2e":{"itemGrants":{"animalCompanion":{"id":"HJM42g9xbYP1Lw72","onDelete":"detach"},"horseSupportBenefit":{"id":"XbJaM1Nwilx1uOw3","onDelete":"detach"}}}},"system":{"description":{"gm":"","value":"<p>Your companion is a horse, pony, or similar equine.</p><p><strong>Size</strong> Medium or Large</p><p><strong>Melee</strong> <span class=\"pf2-icon\">1</span> hoof (agile), <strong>Damage</strong> 1d6 bludgeoning</p><p><strong>Str</strong> +3, <strong>Dex</strong> +2, <strong>Con</strong> +2, <strong>Int</strong> –4, <strong>Wis</strong> +1, <strong>Cha</strong> +0</p><p><strong>Hit Points</strong> 8</p><p><strong>Skill</strong> Survival</p><p><strong>Senses</strong> low-light vision, scent (imprecise, 30 feet)</p><p><strong>Speed</strong> 40 feet</p><p><strong>Special</strong> mount</p><p><strong>Support Benefit</strong> Until the start of your next turn, if you're mounted on your horse and moved 10 feet or more on the action before a melee Strike, add a circumstance bonus to damage for that Strike equal to twice the number of weapon damage dice. If your weapon already has the jousting weapon trait, increase the trait's damage bonus by 2 per die instead.</p><p><strong>Advanced Maneuver</strong> @UUID[Compendium.pf2e-animal-companions.AC-Advanced-Maneuvers.Item.tsOaXTRWQvsKTyaL]{Gallop}</p>"},"rules":[{"adjustName":false,"choices":[{"label":"PF2E.ActorSizeMedium","value":"med"},{"label":"PF2E.ActorSizeLarge","value":"lg"}],"flag":"companionSize","key":"ChoiceSet","prompt":"PF2E.SpecificRule.Prompt.CreatureSize","selection":"lg"},{"key":"CreatureSize","value":"{item|flags.pf2e.rulesSelections.companionSize}"},{"key":"GrantItem","uuid":"Compendium.pf2e-animal-companions.AC-Features.Item.KKOgokqHa7RjVDN6","allowDuplicate":false,"flag":"animalCompanion"},{"key"